{
    "name": "tobento/service-read-write",
    "version": "2.0.3",
    "type": "library",
    "description": "Flexible data readers, writers, modifiers and processors for PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "data",
        "reader",
        "writer",
        "processor",
        "csv",
        "json",
        "ndjson",
        "xml",
        "html",
        "streaming",
        "import",
        "export"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/http-message": "^2.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-iterable": "^2.0",
        "tobento/service-message": "^2.0",
        "tobento/service-support": "^2.0"
    },
    "suggest": {
        "halaxa/json-machine": "Required for the JSON Stream Reader",
        "tobento/service-event": "May be used to support events",
        "tobento/service-file-storage": "To support file storage writer resource",
        "tobento/service-pdf": "Required for pdf resource writer",
        "tobento/service-view": "Required for HTML resource writer",
        "tobento/service-repository": "To support repository writer",
        "tobento/service-storage": "To support storage writer",
        "tobento/service-encryption": "Required for the Encrypt modifier",
        "tobento/service-sanitizer": "Required for the Sanitize modifier",
        "tobento/service-validation": "Required for the Validation modifier"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0",
        "tobento/service-event": "^2.0",
        "halaxa/json-machine": "^1.2",
        "tobento/service-file-storage": "^2.0",
        "tobento/service-pdf": "^2.0",
        "tobento/service-repository": "^2.0",
        "tobento/service-storage": "^2.0",
        "tobento/service-encryption": "^2.0",
        "tobento/service-sanitizer": "^2.0",
        "tobento/service-validation": "^2.0",
        "tobento/service-view": "^2.0",
        "guzzlehttp/guzzle": "^7.10",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\ReadWrite\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\ReadWrite\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}